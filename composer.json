{
    "name": "wazobiamail/wazobiamail-laravel",
    "description": "Send Laravel mail through the WazobiaMail API. WazobiaMail is a Resend alternative that also supports SMTP, with domains, hosted mailboxes, and deliverability tooling.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Bowofade Oyerinde",
            "email": "info@bonifadetechnologies.com",
            "homepage": "https://bonifadetechnologies.com"
        }
    ],
    "homepage": "https://wazobiamail.com",
    "support": {
        "issues": "https://github.com/WazobiaMail/wazobiamail-laravel/issues",
        "source": "https://github.com/WazobiaMail/wazobiamail-laravel"
    },
    "keywords": [
        "laravel",
        "wazobiamail",
        "email",
        "mailer",
        "smtp",
        "inbox",
        "mailboxes",
        "resend-alternative",
        "email-api"
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true,
                "versions": {
                    "wazobiamail/wazobiamail-php": "0.1.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4 || ^8.5",
        "wazobiamail/wazobiamail-php": "^0.1.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/mailer": "^6.0 || ^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "WazobiaMail\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WazobiaMail\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WazobiaMail\\Laravel\\WazobiaMailServiceProvider"
            ],
            "aliases": {
                "WazobiaMail": "WazobiaMail\\Laravel\\Facades\\WazobiaMail"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
